<!DOCTYPE html><html lang="en" data-theme="light"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>VaultMate - Offline Password Manager</title><style>body{margin:0;font-family:sans-serif;background:#F6EFEC;color:#14100F;display:flex;flex-direction:column;min-height:100vh;transition:background 0.3s,color 0.3s}html[data-theme='dark']{background:#14100F;color:#F6EFEC}header,footer{padding:1rem;background:#C1272D;color:#F6EFEC;text-align:center}header{font-size:1.5rem}main{flex:1;padding:1rem;max-width:800px;margin:auto}button{background:#C1272D;color:#F6EFEC;border:none;padding:.5rem 1rem;border-radius:.3rem;cursor:pointer;margin:.2rem}button:hover{opacity:.9}input,select{padding:.4rem;border:1px solid #ccc;border-radius:.3rem;width:100%;margin:.2rem 0}label{display:block;margin-top:.5rem}section{background:#fff;border-radius:.5rem;padding:1rem;margin:.5rem 0;box-shadow:0 2px 5px rgba(0,0,0,0.1)}html[data-theme='dark'] section{background:#222}#empty{text-align:center;color:#777}#list{display:flex;flex-direction:column} .item{display:flex;justify-content:space-between;align-items:center;padding:.5rem 0;border-bottom:1px solid #eee}html[data-theme='dark'] .item{border-color:#444} .item button{background:#555}</style></head><body><header>VaultMate <button id="themeToggle">Toggle Theme</button></header><main><section id="empty"><p>Your vault is empty. Add a new password entry below.</p></section><section id="list"></section><section><form id="addForm"><label for="site">Site</label><input id="site" required><label for="user">Username</label><input id="user" required><label for="pass">Password</label><input id="pass" required><button type="submit">Add Entry</button></form></section><section id="exportSection" style="display:none;"><button id="exportBtn">Export Data</button><input type="file" id="importFile" accept="application/json" style="display:none"><button id="importBtn">Import Data</button></section></main><footer>© 2026 VaultMate</footer><script>const TIER="basic";const BASIC_LIMITS={maxItems:3,export:false,themes:"one",bulk:false,history:false};const LIMITS=TIER==="basic"?BASIC_LIMITS:{maxItems:Infinity,export:true,themes:"all",bulk:true,history:true};const K='vaultmate.v1';const load=()=>{try{return JSON.parse(localStorage.getItem(K))||[] }catch(e){return []}};const save=v=>localStorage.setItem(K,JSON.stringify(v));let vault=load();function render(){const list=document.getElementById('list');list.innerHTML='';if(vault.length===0){document.getElementById('empty').style.display='block'}else{document.getElementById('empty').style.display='none'}vault.forEach((it,i)=>{const div=document.createElement('div');div.className='item';div.innerHTML=`<span>${it.site} / ${it.user}</span><button data-idx="${i}">Delete</button>`;list.appendChild(div);});if(LIMITS.export)document.getElementById('exportSection').style.display='block';else document.getElementById('exportSection').style.display='none';}
function addEntry(e){e.preventDefault();if(vault.length>=LIMITS.maxItems){alert('Item limit reached');return}const site=document.getElementById('site').value.trim();const user=document.getElementById('user').value.trim();const pass=document.getElementById('pass').value.trim();vault.push({site,user,pass});save(vault);document.getElementById('addForm').reset();render();}
function deleteEntry(e){if(e.target.tagName!=='BUTTON')return;const idx=e.target.dataset.idx;vault.splice(idx,1);save(vault);render();}
function exportData(){const data=JSON.stringify(vault,null,2);const blob=new Blob([data],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='vaultmate.json';a.click();URL.revokeObjectURL(url);}
function importData(e){const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const arr=JSON.parse(reader.result);if(Array.isArray(arr)){vault=arr;save(vault);render();}}catch(err){alert('Invalid file');}};reader.readAsText(file);}
function toggleTheme(){const cur=document.documentElement.dataset.theme;const next=cur==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('theme',next);}
function initTheme(){const saved=localStorage.getItem('theme');if(saved){document.documentElement.dataset.theme=saved}else{document.documentElement.dataset.theme='light'}}
document.getElementById('addForm').addEventListener('submit',addEntry);
document.getElementById('list').addEventListener('click',deleteEntry);
document.getElementById('themeToggle').addEventListener('click',toggleTheme);
if(LIMITS.export){document.getElementById('exportBtn').addEventListener('click',exportData);
document.getElementById('importBtn').addEventListener('click',()=>document.getElementById('importFile').click());
document.getElementById('importFile').addEventListener('change',importData);}
initTheme();render();</script></body></html>