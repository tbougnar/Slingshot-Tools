# Kerit Cloud + GitHub Actions hybrid configuration (example)
# Copy values into Kerit service environment variables/secrets as needed.

# Service
PORT=8080
HOST=0.0.0.0
SLINGSHOT_REPO_DIR=.

# Background sync (keeps Kerit in sync with GitHub repo and refreshes site data)
SLINGSHOT_GIT_PULL=1
SLINGSHOT_PULL_INTERVAL=300
SLINGSHOT_SYNC_INTERVAL=60

# Optional: let Kerit run learning-day scan on schedule (UTC)
# If 0, GitHub Actions remains the scheduler for learning-day scans/builds.
SLINGSHOT_LEARNING_DAY=0
SLINGSHOT_LEARNING_CRON_DAY=2
SLINGSHOT_LEARNING_CRON_HOUR=9
SLINGSHOT_LEARNING_CRON_MIN=0

# Optional: Kerit fallback for weekly cycle (use when GitHub Actions minutes run out)
# SLINGSHOT_KERIT_WEEKLY_CYCLE=1
# SLINGSHOT_KERIT_MONDAY_HOUR=9
# SLINGSHOT_KERIT_WEDNESDAY_HOUR=9
# SLINGSHOT_KERIT_CLOSE_BALLOT_HOUR=6
# SLINGSHOT_KERIT_FRIDAY_HOUR=7

# App updater (set for installed apps/builds to use Kerit as instant primary source)
# Example: https://your-kerit-app.example/update.json
SLINGSHOT_UPDATE_URL=

# Model/provider keys (needed if Kerit runs scans/AI features)
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Discord (needed if Kerit handles live vote sync/tally/bot features)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# SLINGSHOT_DISCORD_BOT=1  # run discord_bot.py 24/7 in Kerit (requires discord.py installed)
