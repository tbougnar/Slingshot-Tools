# secrets and credentials — never commit these
.env
.env.*
*.env
youtube_token.json
client_secret.json
jobs/meta_cookies.json
*.key
*.pem
*_token.json
*_secret*.json
secrets/
.github/workflows/*.local.yml

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# build output
dist/
build/

# NOTE: site/ is intentionally public (GitHub Pages). Only the product
# front-ends belong there. The paid installer is delivered through itch.io
# and must never be copied into site/.
site/licenses/

# Paid editions must never be published
paid/

# The full native source of the paid products. These are dead products that are
# not for sale and are not deployed, but their source has no business being in
# a public repository. Only the free editions under site/apps/ are public.
apps/

# The company's money: revenue, margins, prices, budget and public metrics.
# Useful to a competitor, worthless to a customer.
data/earnings.json
data/prices.json
data/price_log.json
data/budget.json
data/reputation.json

# Stale copies of the generator from earlier runs.
*.bak
*.bak2
*.bak3

# One-off scripts kept while building this. Not needed to run anything.
PATTERN_CARD.txt
PATTERNS.md
debug_team.py
debug_team2.py
seed_fixbook.py
mark_verified.py
groq_check.py
itch_login.py
paypal_check.py

# regenerated from the fixbook at build time
data/lessons.txt
# the Friday coach's own lessons. Separate from data/lessons.txt, which is the
# fixbook's; sharing one file meant whichever ran last destroyed the other.
data/coach_lessons.txt

# The growth signals and the goal they feed.
#
# data/signals.json is regenerated from live sources every Wednesday, so a
# committed copy would be last week's numbers. The goal itself is a different
# thing: it is a decision, and losing it would silently reset the company to
# chasing reach forever, so data/goals.json is tracked on purpose.
data/signals.json
data/goal_history.json
data/improve_daily.json
data/weekly_review.md
data/weekly_reviews.json

# Discord state that must never be published.
# data/polls.json holds voters' Discord user ids, and
# data/discord_sent.json only matters on the machine that posts.
data/polls.json
data/discord_sent.json
data/articles.json

# Shorts build output. Thousands of frames and synthesised audio are large,
# regenerable, and meaningless once the video is uploaded.
data/shorts_frames/
data/shorts_audio/
data/shorts_frames.json
data/shorts_script.json
data/shorts_voice.json
data/shorts_video.json
data/shorts_published.json
data/dry_run.json
data/shots/
data/shots.json
data/shorts_thumb.json

# Release state. Tracked, because the count of what has shipped is history.
# Only the generated frame dump and the trailer's working files are not.
data/trailer_frames/
data/trailer_audio/
data/trailer_frames.json
data/trailer_voice.json
data/trailer_script.json

# The countdown the homepage reads. Generated by update_state.py during the
# Pages deploy, never committed: a committed copy goes stale and leaves a
# banner announcing a release that already shipped.
site/update.json
